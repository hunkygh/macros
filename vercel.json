{
  "rewrites": [
    { "source": "/apple-touch-icon.png", "destination": "/api/icon" },
    { "source": "/icon-512.png", "destination": "/api/icon" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}